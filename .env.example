# Настройки EasyTv. run.sh копирует этот файл в .env при первом запуске.

# Порт веб-интерфейса. По нему же телевизоры забирают видео.
EASYTV_PORT=8080

# IP этого компьютера в домашней сети. Оставьте пустым: run.sh определит сам.
EASYTV_PUBLIC_HOST=

# Адреса телевизоров, которые опрашиваются напрямую: IP или полный адрес описания устройства
# (http://…, его показывает ./run.sh discover). В Docker это самый надёжный способ их найти:
# обычный поиск (multicast) из контейнера в домашнюю сеть не выходит.
EASYTV_TV_HOSTS=192.168.0.72,192.168.0.180

# Перед запуском run.sh ищет телевизоры с самого компьютера (там multicast работает)
# и передаёт найденные адреса в контейнер. off — не искать.
EASYTV_HOST_DISCOVERY=on

# Сеть контейнера. bridge — обычная (по умолчанию). host — контейнер в сети компьютера, обычный
# поиск работает изнутри. В Docker Desktop сначала включите Settings → Resources → Network →
# Enable host networking.
EASYTV_NETWORK=bridge

# Подсети, которые перебираются при поиске новых телевизоров.
# Пусто: run.sh возьмёт подсеть /24 этого компьютера. "none" — не перебирать.
EASYTV_SCAN_SUBNETS=

# Как часто искать телевизоры, в секундах.
EASYTV_DISCOVERY_INTERVAL=15

# Максимальное качество роликов с YouTube (высота кадра).
EASYTV_MAX_VIDEO_HEIGHT=1080
